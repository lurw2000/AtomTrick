diff --git a/gotennet/configs/experiment/md22_at_at.yaml b/gotennet/configs/experiment/md22_at_at.yaml
new file mode 100644
index 0000000..bfcfc9e
--- /dev/null
+++ b/gotennet/configs/experiment/md22_at_at.yaml
@@ -0,0 +1,82 @@
+# @package _global_
+
+# Reproduce-test experiment for MD22 on AT-AT.
+# Protocol follows the MACE / Equiformer-V2 / ViSNet convention:
+#   - seeded random split over the full trajectory
+#   - test = everything not in train/val
+#
+# Per-molecule train sizes (widely cited):
+#   Ac-Ala3-NHMe: 6000    DHA: 8000          stachyose: 8000
+#   AT-AT: 3000           AT-AT-CG-CG: 2000  buckyball-catcher: 600
+#   double-walled_nanotube: 800
+# val_size is commonly 500 (or 10% of train for the two smallest systems).
+#
+# To run:
+#   python gotennet/train.py experiment=md22_at_at
+#
+# To run other molecules, duplicate this file and change:
+#   dataset_arg, label, train_size, val_size.
+
+defaults:
+  - override /datamodule: md22.yaml
+  - override /model: gotennet.yaml
+  - override /callbacks: default.yaml
+  - override /logger: wandb.yaml
+  - override /trainer: default.yaml
+
+datamodule:
+  hparams:
+    seed: 1
+    standardize: true
+    splits: null
+    dataset_arg: AT_AT
+    train_size: 3000
+    val_size: 500
+    test_size: null  # = dataset_len - train - val; hold-out test
+    inference_batch_size: 4
+
+label: "AT_AT"
+model:
+  lr: 0.0001
+  lr_warmup_steps: 1000
+  lr_monitor: "validation/val_loss"
+  lr_minlr: 1.e-07
+  lr_patience: 30
+  weight_decay: 0.01
+  use_ema: True
+  task_config:
+    task_loss: "MSELoss"
+    ema_rates:
+        - 0.05
+        - 1.00
+    loss_weights:
+        - 0.05
+        - 0.95
+
+  representation:
+    n_interactions: 8
+    n_atom_basis: 384
+    radial_basis: "expnorm"
+    n_rbf: 32
+    edge_updates: "linw_mlpa"
+    lmax: 2
+    evec_dim: 768
+    emlp_dim: 768
+
+  output:
+    n_hidden: 256
+
+
+trainer:
+  max_epochs: 3000
+  inference_mode: False
+
+callbacks:
+  early_stopping:
+    monitor: "validation/val_loss_og"
+    patience: 1000
+  model_checkpoint:
+    monitor: "validation/val_loss_og"
+project: "gotennet_md22"
+
+task: "rMD17"
