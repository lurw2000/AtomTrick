--- a/gotennet/models/tasks/MDTask.py
+++ b/gotennet/models/tasks/MDTask.py
@@ -11,6 +11,24 @@ from gotennet.models.components.outputs import AtomwiseV3
 from gotennet.models.tasks.Task import Task
 
 
+class MeanL2Error(torchmetrics.Metric):
+    """Mean per-atom L2 norm of the force error: mean(||F_pred - F_true||_2)."""
+
+    def __init__(self, **kwargs):
+        super().__init__(**kwargs)
+        self.add_state("sum_l2", default=torch.tensor(0.0), dist_reduce_fx="sum")
+        self.add_state("count", default=torch.tensor(0), dist_reduce_fx="sum")
+
+    def update(self, preds: torch.Tensor, target: torch.Tensor):
+        # preds, target: [n_atoms, 3]
+        l2 = torch.norm(preds - target, dim=-1)  # [n_atoms]
+        self.sum_l2 += l2.sum()
+        self.count += l2.numel()
+
+    def compute(self):
+        return self.sum_l2 / self.count
+
+
 class MDTask(Task):
     """
     Task for MD17 molecular dynamics dataset.
